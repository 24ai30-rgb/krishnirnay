# Android / Gradle
*.iml
.gradle/
.kotlin/
/local.properties
.idea/
.DS_Store
build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
app/release/
app/debug/

# Claude Code local session state
.claude/

# Android signing / secrets — never commit
app/google-services.json
*.jks
*.keystore
local.properties

# Python / FastAPI
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Server secrets — never commit
server/.env
server/.env.*
!server/.env.example

# On-device AI model — large (~500MB), license-gated, never committed. See
# server/models/on_device/README.md for how a developer stages it locally.
server/models/on_device/*.task

# Misc
*.log
.env

# Local debug captures (screenshots / UI dumps)
/*.png
/*_ui*.xml
server/*.png
nul

.superpowers/

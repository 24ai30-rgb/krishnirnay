# Copy to .env and fill in real values. Never commit .env.

# Must match Android's SERVER_API_KEY (BuildConfig)
API_KEY=dev-only-change-me

# Google Gemini (chat) — leave empty to keep chat honestly disabled
GEMINI_API_KEY=

# Weather — WeatherAPI.com forecast endpoint. Get a free key at
# https://www.weatherapi.com/my/ . Leave empty to keep GET /v1/weather
# honestly reporting 503 "unavailable" rather than fabricating a reading.
WEATHER_API_KEY=your_weatherapi_key_here

# Government mandi/market prices — data.gov.in's AGMARKNET resource. Get a
# free key at https://data.gov.in (sent as the `api-key` query parameter,
# which is what that API actually accepts — not a Bearer header). Leave empty
# to keep GET /v1/market honestly reporting 503 "unavailable" rather than
# fabricating a price.
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Local LLM — a self-hosted Ollama-compatible server, never a cloud LLM.
# Defaults assume `ollama serve` running locally with the model below pulled
# (`ollama pull deepseek-r1:7b`). See LOCAL_LLM_SETUP.md, including the
# measured speed/language trade-offs between models.
LOCAL_LLM_PROVIDER=ollama
# 127.0.0.1 rather than "localhost": localhost can resolve to ::1 first and
# stall on hosts where Ollama only listens on IPv4.
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=deepseek-r1:7b
# Only have one model pulled? Set LOCAL_LLM_MODEL, _HI and _MR all to its exact
# name:tag (check `ollama list`) — a model that is not installed makes the app
# report "Local model unavailable".

# Hindi/Marathi (Phase 4) — deepseek-r1:7b answers in the right script but
# incoherently for these two languages. qwen2.5:3b (`ollama pull qwen2.5:3b`)
# is fast and reliable for Hindi; Marathi needed the larger qwen2.5:7b
# (`ollama pull qwen2.5:7b`) to be reliably coherent — see config.py's
# comment for the measured comparison. Leave empty to fall back to
# LOCAL_LLM_MODEL (a single-model setup).
LOCAL_LLM_MODEL_HI=qwen2.5:3b
LOCAL_LLM_MODEL_MR=qwen2.5:7b

# Local inference is slow (~5 tokens/second for a 7B model on a CPU-only box,
# plus ~13s cold model load), so the read budget is far larger than for any
# network API while the connect budget stays small. See LOCAL_LLM_SETUP.md.
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=5
LOCAL_LLM_READ_TIMEOUT_SECONDS=120
# Caps worst-case latency — a farmer-facing explanation is a few sentences.
LOCAL_LLM_NUM_PREDICT=220
# How long Ollama keeps the model loaded after a request (default 30m). Without
# this Ollama unloads after 5 min and the next question waits ~80s for a reload;
# the server also preloads the model once at startup.
LOCAL_LLM_KEEP_ALIVE=30m
LOCAL_LLM_TEMPERATURE=0.2

# IVR / keypad-phone support (Phase 4G) — leave empty to keep GET
# /v1/ivr/status honestly reporting "not configured". A real phone call
# always needs SOME telephony provider (Twilio, Exotel, ...) — this is
# never "completely offline".
IVR_PROVIDER=
IVR_API_KEY=
IVR_AUTH_TOKEN=
IVR_PHONE_NUMBER=

RISK_MODEL_PATH=models/agricultural_risk_final.pkl
CORS_ORIGINS=
